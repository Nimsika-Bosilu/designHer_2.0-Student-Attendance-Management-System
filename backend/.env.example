# ==============================================
# Environment Variables for Attendance System API
# ==============================================
# Copy this file and rename it to .env
# Then fill in your own values.
# NEVER push the .env file to GitHub!
# ==============================================

# Database Connection URL
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:YOUR_PASSWORD_HERE@localhost:3306/attendance_system_db"

# JWT Secret Key (used to create login tokens)
# Make this a long, random string. Keep it secret!
JWT_SECRET="your-super-secret-key-change-this-to-something-random"

# Server Port
PORT=5000
